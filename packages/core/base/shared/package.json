{
  "name": "@saas-core/shared",
  "version": "5.5.4",
  "homepage": "https://github.com/mask-mj/saas-admin",
  "bugs": "https://github.com/mask-mj/saas-admin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mask-mj/saas-admin.git",
    "directory": "packages/@saas-core/base/shared"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm unbuild",
    "stub": "pnpm unbuild --stub"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "exports": {
    "./utils": {
      "types": "./src/utils/index.ts",
      "development": "./src/utils/index.ts",
      "default": "./dist/utils/index.mjs"
    },
    "./color": {
      "types": "./src/color/index.ts",
      "development": "./src/color/index.ts",
      "default": "./dist/color/index.mjs"
    },
    "./cache": {
      "types": "./src/cache/index.ts",
      "development": "./src/cache/index.ts",
      "default": "./dist/cache/index.mjs"
    },
    "./global-state": {
      "types": "./src/global-state.ts",
      "development": "./src/global-state.ts",
      "default": "./dist/global-state.mjs"
    }
  },
  "publishConfig": {
    "exports": {
      "./utils": {
        "types": "./dist/utils/index.d.ts",
        "default": "./dist/utils/index.mjs"
      },
      "./color": {
        "types": "./dist/color/index.d.ts",
        "default": "./dist/color/index.mjs"
      },
      "./cache": {
        "types": "./dist/cache/index.d.ts",
        "default": "./dist/cache/index.mjs"
      },
      "./global-state": {
        "types": "./dist/global-state.d.ts",
        "default": "./dist/global-state.mjs"
      }
    }
  },
  "dependencies": {
    "@ctrl/tinycolor": "catalog:",
    "clsx": "catalog:",
    "dayjs": "catalog:",
    "defu": "catalog:",
    "nprogress": "catalog:",
    "tailwind-merge": "catalog:",
    "theme-colors": "catalog:"
  },
  "devDependencies": {
    "@types/nprogress": "catalog:"
  }
}
